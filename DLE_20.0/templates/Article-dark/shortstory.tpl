<article class="post post-list clearfix">

<div class="thumb rounded">
<span class="post-format-sm"><i class="icon-picture"></i></span>
<a href="{full-link}"><div class="inner"><img src="{image-1}" alt="{title}" /></div></a>
</div>

<div class="details">
<ul class="meta list-inline mb-3">
<li class="list-inline-item">[profile]<img src="{foto}" class="author" alt="author"/>{login}[/profile]</li>
<li class="list-inline-item">{link-category}</li>
<li class="list-inline-item">{date}</li>
</ul>
<h5 class="post-title"><a href="{full-link}">{title}</a></h5>
<p class="excerpt mb-0">{short-story limit="130"}...</p>
<div class="post-bottom clearfix d-flex align-items-center">
<div class="social-share me-auto"></div>
<div class="more-button float-end"><a href="{full-link}"><span class="icon-options"></span></a></div>
</div>
</div>
    
</article>
							
