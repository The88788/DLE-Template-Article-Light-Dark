[allow-download]
<span class="attachment theme-attachment d-block rounded bordered p-3 mb-3">
<i class="icon-cloud-download"></i> Скачать файл: <a href="{link}">{name}</a> [count] <span class="text-muted">[{size}], скачиваний: {count}</span>[/count]
[allow-online]<br><i class="icon-eye"></i> Посмотреть онлайн: <a data-highslide="file" data-type="iframe" href="{online-view-link}" target="_blank">{name}</a>[/allow-online]
</span>
[/allow-download]
[not-allow-download]<span class="attachment theme-attachment d-block rounded bordered p-3 mb-3">У вас нет доступа к скачиванию файлов с нашего сервера</span>[/not-allow-download]
