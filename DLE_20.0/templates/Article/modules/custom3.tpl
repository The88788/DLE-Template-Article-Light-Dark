<article class="swiper-slide post post-over-content">
<div class="details clearfix">
<a href="{category-url}" class="category-badge">{category}</a>
<h4 class="post-title"><a href="{full-link}">{title}</a></h4>
<ul class="meta list-inline mb-0">
<li class="list-inline-item">[profile]{login}[/profile]</li>
<li class="list-inline-item">{date}</li>
</ul>
</div>
<a href="{full-link}"><div class="thumb rounded"><div class="inner"><img src="{image-1}" alt="{title}" /></div></div></a>
</article>
