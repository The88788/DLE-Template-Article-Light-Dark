<article class="post">

<div class="thumb rounded">
<a href="{category-url}" class="category-badge position-absolute">{category}</a>
<span class="post-format"><i class="icon-picture"></i></span>
<a href="{full-link}"><div class="inner"><img src="{image-1}" alt="{title}" /></div></a>
</div>

<ul class="meta list-inline mt-4 mb-0">
<li class="list-inline-item">[profile]<img src="{foto}" class="author" alt="author"/>{login}[/profile]</li>
<li class="list-inline-item">{date}</li>
</ul>
    
<h5 class="post-title mb-2 mt-2"><a href="{full-link}">{title}</a></h5>
<p class="excerpt mb-0">{short-story limit="110"}...</p>

</article>
