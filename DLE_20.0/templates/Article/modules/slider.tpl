<article class="swiper-slide post featured-post-lg">

<div class="details clearfix">
<a href="{category-url}" class="category-badge">{category}</a>
<h2 class="post-title"><a href="{full-link}">{title}</a></h2>
<ul class="meta list-inline mb-0">
<li class="list-inline-item">[profile]{login}[/profile]</li>
<li class="list-inline-item">{date}</li>
</ul>
</div>

<a href="{full-link}"><div class="thumb rounded"><div class="inner data-bg-image" data-bg-image="{image-1}"></div></div></a>

</article>
