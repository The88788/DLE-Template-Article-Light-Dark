<div class="post post-list-sm circle">

<div class="thumb circle">
[profile]<div class="inner"><img src="{foto}" style="height:60px" alt="{login}" /></div>[/profile]
</div>

<div class="details clearfix">
<ul class="meta list-inline mb-1 mb-1">
<li class="list-inline-item"><i class="icon-user"></i> {login}</li>
<li class="list-inline-item"><i class="icon-calendar"></i> {date=d-M, H:i}</li>
</ul>
<p href="{news-link}" class="excerpt mb-1 text-justify text-white">{comment limit="80"}..</p>
<a href="{news-link}" class="fw-bold" style="font-size:13px">К комментарию</a>
</div>

</div>