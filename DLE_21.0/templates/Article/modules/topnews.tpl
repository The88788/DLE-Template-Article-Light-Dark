<div class="post post-list-sm circle">

<div class="thumb circle">
<a href="{full-link}"><div class="inner"><img src="{image-1}" style="height:60px" alt="{title}" /></div></a>
</div>

<div class="details clearfix">
<h6 class="post-title my-0"><a href="{full-link}">{title limit="50"}..</a></h6>
<ul class="meta list-inline mt-1 mb-0"><li class="list-inline-item"><i class="icon-calendar"></i> {date}</li></ul>
</div>

</div>